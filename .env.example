# =====================================================================
# MiniShop — configuration LOCALE (modèle).
#
#   cp .env.example .env        # puis éditer .env, jamais dans Git
#
# Ce fichier est lu par l'application (App\Config\Env) puis par
# scripts/db_init.php et run.sh. Une variable d'environnement réelle
# gagne toujours sur ce fichier :
#
#   DB_NAME=minishop_test ./run.sh
#   STORAGE_DRIVER=sql php scripts/db_init.php --check
#
# Le fichier `.env` est ignoré par Git (.gitignore) : aucun mot de passe
# ne doit entrer dans l'historique (§14.1).
# =====================================================================

# --- Application -------------------------------------------------------
APP_ENV=dev
APP_DEBUG=1

# --- Pilote de données -------------------------------------------------
# json : moteur JSON natif (data/minishop/*.json) — aucun service à installer
# sql  : MySQL / MariaDB via PDO (base à créer avec scripts/db_init.php)
STORAGE_DRIVER=json

# Dossier de données du pilote JSON (vide = data/minishop à la racine)
DATA_PATH=

# --- Base MySQL / MariaDB (utilisée quand STORAGE_DRIVER=sql) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=minishop
DB_USER=root
DB_PASSWORD=

# Socket Unix (facultatif). Vide = TCP 127.0.0.1:3306.
# Utile si la socket n'est pas sur un chemin standard, ou si PHP tourne en root
# (le greffon unix_socket compare l'utilisateur du système, pas un mot de passe :
#  root ne peut pas servir PHP lancé sous votre compte — voir README, « Base de
#  données locale » et l'option « --compte » de db_init.php).
# DB_SOCKET=/run/mysqld/mysqld.sock
DB_SOCKET=

# --- Serveur de développement (run.sh) ---------------------------------
PORT=8000
HOST=0.0.0.0

# Dossier dédié hors webroot/dépôt pour la rotation manuelle des sauvegardes.
# Vide = aucune rotation. Lire docs/18-politique-conservation.md avant activation.
NETTOYAGE_SAUVEGARDES=
