    "test:router": "php tests/php/dev_router_test.php",
    "test:categorie": "node scripts/wasm_run.mjs tests/php/categorie_doublon_test.php",
    "test:ui": "node scripts/ui-e2e-categories.mjs",
    "test:ui-panier": "node scripts/wasm_run.mjs scripts/seed.php && node scripts/ui-e2e-panier.mjs",
    "test:ui-apropos": "node scripts/ui-e2e-apropos.mjs",
    "test:heure": "node scripts/wasm_run.mjs tests/php/heure_test.php",
    "test:adresse": "node scripts/wasm_run.mjs tests/php/adresse_livraison_test.php",
    "test:ui-annulation": "node scripts/wasm_run.mjs scripts/seed.php && node scripts/ui-e2e-annulation.mjs",
    "test:ui-stocks": "node scripts/wasm_run.mjs scripts/seed.php && node scripts/ui-e2e-stocks.mjs",
    "test:pages": "node scripts/wasm_run.mjs tests/php/pages_pied_de_page_test.php",
    "test:ui-pied-de-page": "node scripts/wasm_run.mjs scripts/seed.php && node scripts/ui-e2e-pied-de-page.mjs",
    "test:ui-catalogue": "node scripts/wasm_run.mjs scripts/seed.php && node scripts/ui-e2e-catalogue.mjs",
    "test:ui-produit": "node scripts/wasm_run.mjs scripts/seed.php && node scripts/ui-e2e-produit.mjs",
    "test:ui-panier-tableau": "node scripts/wasm_run.mjs scripts/seed.php && node scripts/ui-e2e-panier-tableau.mjs",
    "test:ui-commandes-tableau": "node scripts/wasm_run.mjs scripts/seed.php && node scripts/ui-e2e-commandes-tableau.mjs",
    "test:ui-categories-tableau": "node scripts/wasm_run.mjs scripts/seed.php && node scripts/ui-e2e-categories-tableau.mjs",
    "test:ui-alignement": "node scripts/wasm_run.mjs scripts/seed.php && node scripts/ui-e2e-alignement.mjs",
    "test:ui-formulaires": "node scripts/wasm_run.mjs scripts/seed.php && node scripts/ui-e2e-formulaires.mjs",
    "test:ui-divers": "node scripts/wasm_run.mjs scripts/seed.php && node scripts/ui-e2e-divers.mjs",
    "test:ui-codes": "node scripts/wasm_run.mjs scripts/seed.php && node scripts/ui-e2e-codes.mjs",
    "test:ui-retractation": "node scripts/wasm_run.mjs scripts/seed.php && node scripts/ui-e2e-retractation.mjs",
    "test:ui-mentions": "node scripts/wasm_run.mjs scripts/seed.php && node scripts/ui-e2e-mentions.mjs",
    "test:ui-heure": "node scripts/wasm_run.mjs scripts/seed.php && node scripts/ui-e2e-heure.mjs",
    "test:all": "node scripts/run-all-tests.mjs",
    "lint:types": "node scripts/wasm_run.mjs scripts/strict_types_lint.php"
