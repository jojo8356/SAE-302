@startuml mcd_minishop
title MCD — MiniShop (9 entités)
hide circle
skinparam linetype ortho

entity "CATEGORIE" as CAT {
  * id_categorie <<PK>>
  --
  nom
  slug
  description
}

entity "PRODUIT" as PRO {
  * id_produit <<PK>>
  --
  reference
  nom
  slug
  description
  prix_ht
  tva
  prix_ttc
  stock
  stock_initial
  seuil_alerte
  visible
  image_url
  date_creation
  date_modification
  * id_categorie <<FK>>
}

entity "STOCK_MOVEMENT_HISTORY" as SMH {
  * id_mouvement <<PK>>
  --
  id_produit
  reference_produit
  nom_produit
  mode_mouvement
  quantite
  stock_avant
  stock_apres
  motif
  changed_by
  changed_by_role
  changed_at
}

entity "PARAMETRE" as PAR {
  * cle <<PK>>
  --
  valeur
  unite
  comment
  date_modification
}

entity "CLIENT" as CLI {
  * id_client <<PK>>
  --
  nom
  prenom
  email
  mot_de_passe_hash
  telephone
  adresse_livraison
  code_postal
  ville
  actif
  date_creation
  derniere_connexion
}

entity "COMMANDE" as COM {
  * id_commande <<PK>>
  --
  numero
  adresse_livraison
  statut
  montant_total
  frais_port
  montant_avant_annulation
  commentaire
  date_commande
  date_modification
  * id_client <<FK>>
}

entity "LIGNE_COMMANDE" as LIG {
  * id_ligne <<PK>>
  --
  quantite
  prix_unitaire
  total_ligne
  * id_commande <<FK>>
  * id_produit <<FK>>
}

entity "ORDER_STATUS_HISTORY" as HIS {
  * id <<PK>>
  --
  * order_id <<FK>>
  old_status
  new_status
  changed_by
  changed_by_role
  commentaire
  changed_at
}

entity "ADMINISTRATEUR" as ADM {
  * id_admin <<PK>>
  --
  nom
  prenom
  email
  mot_de_passe_hash
  role
  actif
  date_creation
  derniere_connexion
}

CAT ||--o{ PRO : contient
CLI ||--o{ COM : passe
COM ||--|{ LIG : "contient (>=1, RB-04)"
PRO ||--o{ LIG : référence
COM ||--o{ HIS : trace
PRO ..o{ SMH : "snapshot audit (sans FK)"
PAR .. PRO : tva_defaut
PAR .. COM : frais_port / franchise_port
@enduml
