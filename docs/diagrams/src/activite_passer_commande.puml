@startuml activite_passer_commande
title Activité — passer commande (UC-07)
start
:Consulter le catalogue ou rechercher;
:Ouvrir une fiche produit;
if (Produit visible et en stock ?) then (oui)
  :Ajouter au panier (quantité plafonnée au stock, RB-18);
else (non)
  :Bouton désactivé, mention rupture;
  stop
endif
:Consulter le panier\n(prix unitaire TTC, sous-total TTC, frais de port, total TTC);
if (Client connecté ?) then (non)
  :Se connecter ou créer un compte;
else (oui)
endif
:Saisir / confirmer l'adresse de livraison\net cocher ou non le paiement simulé;
:Valider la commande (POST /commande/valider + _csrf);
if (Stock suffisant et panier non vide ?) then (oui)
  :Transaction SQL (sp_create_order_from_basket)\nverrou FOR UPDATE + lignes + décrément + port figé;
  if (Paiement simulé coché ?) then (oui)
    :Statut initial PAYEE + historique;
  else (non)
    :Statut initial EN_PREPARATION + historique;
  endif
  :Vider le panier (session);
  :Rediriger 302 /mes-commandes/{id}\n(numéro + récapitulatif + flash succès);
else (non)
  :Rollback + message traduit (ex. STOCK_INSUFFISANT)\npanier conservé, 302 /panier;
endif
stop
@enduml
