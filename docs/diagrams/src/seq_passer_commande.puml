@startuml seq_passer_commande
title Séquence — valider une commande (UC-07, RB-04/05/06/15/18/20, ENF-16)
actor Client
participant "CommandeController" as CC
participant "CommandeRepository" as CR
participant "PanierSession" as PS
database "Base (SQL)" as DB

Client -> CC : POST /commande/valider (adresse, paiement_simule, _csrf)
CC -> CC : verifierCsrf() + Auth::exigeClient()
CC -> DB : setActor({id, role: 'CLIENT', nom})
CC -> CR : createOrderFromBasket(id_client, adresse, panier, payee)
CR -> DB : CALL sp_create_order_from_basket(\nid_client, adresse, panier_json, payee)

DB -> DB : START TRANSACTION + verrou FOR UPDATE sur le stock
DB -> DB : contrôle disponibilité + insertion lignes\n+ décrément stock + port figé + statut initial

alt p_code_retour = 'OK'
  DB -> DB : COMMIT (statut PAYEE si payee=1 sinon EN_PREPARATION)
  DB --> CR : {p_id_commande, p_numero, p_montant, OK}
  CR --> CC : {id_commande, numero, montant}
  CC -> PS : vider()
  CC --> Client : 302 /mes-commandes/{id} + flash succès
  ||8||
else erreur métier (STOCK_INSUFFISANT ou panier vide)
  DB -> DB : ROLLBACK
  DB --> CR : p_code_retour != 'OK'
  CR --> CC : throw BusinessError
  CC --> Client : 302 /panier + message humain (panier conservé)
end
@enduml
