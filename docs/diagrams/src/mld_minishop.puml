@startuml mld_minishop
title MLD — MiniShop (9 tables, clés, index, contraintes)
hide circle
hide methods
skinparam linetype ortho

entity "administrateur" as ADM {
  * id_admin : INT UNSIGNED <<PK>>
  --
  nom : VARCHAR(100)
  prenom : VARCHAR(100)
  email : VARCHAR(190) <<UNIQUE>>
  mot_de_passe_hash : CHAR(60)
  role : ENUM('SUPER','GESTIONNAIRE')
  actif : TINYINT(1) CHECK IN (0,1)
  date_creation : DATETIME
  derniere_connexion : DATETIME
}

entity "categorie" as CAT {
  * id_categorie : INT UNSIGNED <<PK>>
  --
  nom : VARCHAR(100) <<UNIQUE>>
  slug : VARCHAR(120) <<UNIQUE>>
  description : VARCHAR(500)
}

entity "produit" as PRO {
  * id_produit : INT UNSIGNED <<PK>>
  --
  reference : VARCHAR(30) <<UNIQUE>>
  nom : VARCHAR(150)
  slug : VARCHAR(180) <<UNIQUE>>
  description : TEXT
  prix_ht : DECIMAL(10,2) CHECK > 0
  tva : DECIMAL(5,2)
  prix_ttc : DECIMAL(10,2)
  stock : INT CHECK >= 0
  stock_initial : INT
  seuil_alerte : INT
  * id_categorie : INT UNSIGNED <<FK>>
  visible : TINYINT(1) CHECK IN (0,1)
  image_url : VARCHAR(255)
  date_creation : DATETIME
  date_modification : DATETIME
}

entity "stock_movement_history" as SMH {
  * id_mouvement : BIGINT UNSIGNED <<PK>>
  --
  id_produit : INT UNSIGNED
  reference_produit : VARCHAR(30)
  nom_produit : VARCHAR(150)
  mode_mouvement : ENUM('SET','DELTA')
  quantite : INT
  stock_avant : INT CHECK >= 0
  stock_apres : INT CHECK >= 0
  motif : VARCHAR(200)
  changed_by : INT UNSIGNED
  changed_by_role : ENUM('CLIENT','ADMIN','SYSTEME')
  changed_at : DATETIME
}

entity "parametre" as PAR {
  * cle : VARCHAR(50) <<PK>>
  --
  valeur : VARCHAR(100)
  unite : VARCHAR(10)
  comment : VARCHAR(255)
  date_modification : DATETIME
}

entity "client" as CLI {
  * id_client : INT UNSIGNED <<PK>>
  --
  nom : VARCHAR(100)
  prenom : VARCHAR(100)
  email : VARCHAR(190) <<UNIQUE>>
  mot_de_passe_hash : CHAR(60)
  telephone : VARCHAR(20)
  adresse_livraison : VARCHAR(255)
  code_postal : VARCHAR(10)
  ville : VARCHAR(100)
  actif : TINYINT(1) CHECK IN (0,1)
  date_creation : DATETIME
  derniere_connexion : DATETIME
}

entity "commande" as COM {
  * id_commande : INT UNSIGNED <<PK>>
  --
  numero : VARCHAR(20) <<UNIQUE>>
  * id_client : INT UNSIGNED <<FK>>
  adresse_livraison : VARCHAR(255)
  statut : ENUM('BROUILLON','EN_PREPARATION','PAYEE','EXPEDIEE','LIVREE','ANNULEE')
  montant_total : DECIMAL(10,2) CHECK >= 0
  frais_port : DECIMAL(10,2) CHECK >= 0
  montant_avant_annulation : DECIMAL(10,2)
  commentaire : VARCHAR(500)
  date_commande : DATETIME
  date_modification : DATETIME
}

entity "ligne_commande" as LIG {
  * id_ligne : BIGINT UNSIGNED <<PK>>
  --
  * id_commande : INT UNSIGNED <<FK ON DELETE CASCADE>>
  * id_produit : INT UNSIGNED <<FK ON DELETE RESTRICT>>
  quantite : INT CHECK > 0
  prix_unitaire : DECIMAL(10,2) CHECK > 0
  total_ligne : DECIMAL(10,2)
}

entity "order_status_history" as HIS {
  * id : BIGINT UNSIGNED <<PK>>
  --
  * order_id : INT UNSIGNED <<FK ON DELETE CASCADE>>
  old_status : VARCHAR(20)
  new_status : VARCHAR(20)
  changed_by : INT UNSIGNED
  changed_by_role : ENUM('CLIENT','ADMIN','SYSTEME')
  commentaire : VARCHAR(500)
  changed_at : DATETIME
}

CAT ||--o{ PRO : "ON UPDATE CASCADE\nON DELETE RESTRICT"
CLI ||--o{ COM : "ON UPDATE CASCADE\nON DELETE RESTRICT"
COM ||--o{ LIG : "ON DELETE CASCADE"
PRO ||--o{ LIG : "ON DELETE RESTRICT"
COM ||--o{ HIS : "ON DELETE CASCADE"

note bottom of PRO
  Index : ft_produit_recherche (nom, description) FULLTEXT,
  idx_produit_categorie (id_categorie), idx_produit_visible (visible, stock).
  prix_ttc recalculé par trg_produit_ttc / trg_produit_ttc_update.
end note

note bottom of COM
  Index : idx_commande_client (id_client), idx_commande_statut (statut).
  ligne_commande : idx_ligne_commande, idx_ligne_produit.
  stock_movement_history : idx_stock_movement_product (sans FK).
end note
@enduml
