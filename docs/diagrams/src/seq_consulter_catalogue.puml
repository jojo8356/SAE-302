@startuml seq_consulter_catalogue
title Séquence 5 (bonus) — consulter le catalogue et la fiche produit (UC-01 / UC-03)

autonumber
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName "DejaVu Sans"
skinparam ArrowColor #0F294A
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #1E3A5F
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #1E3A5F
skinparam DatabaseBackgroundColor #F1F5F9
skinparam DatabaseBorderColor #0F294A
skinparam NoteBackgroundColor #F8FAFC
skinparam NoteBorderColor #1E3A5F
skinparam SequenceLifeLineBorderColor #334155

actor Visiteur
participant "CatalogueController" as CC
participant "CategorieRepository" as CAT
participant "ProduitRepository" as PR
database "Store / SQL" as DB

Visiteur -> CC : GET /catalogue?cat=2&prix_max=500&stock=1&tri=prix_asc&page=2
activate CC
CC -> CAT : listerAvecCompteur() : array
activate CAT
CAT -> DB : select categorie + comptage visible = 1
activate DB
DB --> CAT : categories
deactivate DB
CAT --> CC : categories
deactivate CAT

CC -> CC : valider filtres (tri liste blanche, bornes, par_page = 12)
CC -> PR : searchProducts(criteres) : array
activate PR
PR -> DB : CALL sp_search_products(...)\n(ou filtre v_catalogue paginé à 12)
activate DB
DB --> PR : lignes + total
deactivate DB
PR --> CC : resultat{lignes, total, page, par_page, pages}
deactivate PR

CC --> Visiteur : 200 HTML catalogue/index (filtres + pagination)
deactivate CC

opt consultation d'une fiche produit (UC-03, RB-19)
  Visiteur -> CC : GET /produit/{slug}
  activate CC
  CC -> PR : findVisibleBySlug(slug) : ?array
  activate PR
  PR -> DB : select produit WHERE slug = ? AND visible = 1
  activate DB
  DB --> PR : produit | null
  deactivate DB
  PR --> CC : produit | null
  deactivate PR

  alt produit = null (absent ou masqué)
    CC --> Visiteur : 404 HTML errors/404
    ||8||
  else produit trouvé
    CC -> CAT : find(id_categorie) : ?array
    activate CAT
    CAT --> CC : categorie
    deactivate CAT
    CC -> CC : Views::etatStock(produit)
    CC --> Visiteur : 200 HTML catalogue/produit (prix TTC, TVA, stock)
  end
  deactivate CC
end

note right of CC : filtres invalides ignorés, jamais de 500 (§4.3)
@enduml
