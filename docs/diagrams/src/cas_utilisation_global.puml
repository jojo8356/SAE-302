@startuml cas_utilisation_global
title MiniShop — cas d'utilisation (vue globale, §5.1.1)

left to right direction
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName "DejaVu Sans"
skinparam packageStyle rectangle
skinparam ArrowColor #0F294A
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #1E3A5F
skinparam UsecaseBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #1E3A5F

actor "Visiteur" as V
actor "Client" as C
C --|> V

actor "Administrateur\n(GESTIONNAIRE)" as A
actor "Super administrateur\n(SUPER)" as S
S --|> A

rectangle "MiniShop — Front-office" {
  usecase "UC-01 Consulter le catalogue" as UC01
  usecase "UC-02 Rechercher un produit" as UC02
  usecase "UC-03 Consulter une fiche produit" as UC03
  usecase "Contacter / Préférences\n(/contact, /preferences)" as UCINF
  usecase "UC-04 Créer un compte" as UC04
  usecase "UC-05 Se connecter / déconnecter" as UC05A
  usecase "UC-06 Gérer le panier" as UC06
  usecase "UC-05b Gérer son compte (/compte)" as UC05B
  usecase "UC-07 Passer une commande" as UC07
  usecase "UC-08 Consulter ses commandes" as UC08
  usecase "UC-09 Annuler une commande" as UC09
}

rectangle "MiniShop — Back-office (RB-13 séparé)" {
  usecase "Se connecter au back-office" as UCBA
  usecase "UC-10 Gérer les produits" as UC10
  usecase "UC-11 Gérer les catégories" as UC11
  usecase "UC-12 Gérer les stocks" as UC12
  usecase "UC-13 Consulter les commandes" as UC13
  usecase "UC-14 Modifier le statut" as UC14
  usecase "Gérer les paramètres\n(/admin/parametres)" as UC16
  usecase "Gérer les comptes d'équipe\n(/admin/equipe)" as UC15
}

V --> UC01
V --> UC02
V --> UC03
V --> UCINF
V --> UC04
V --> UC05A
V --> UC06

C --> UC05B
C --> UC07
C --> UC08

UC07 ..> UC06 : <<include>>
UC07 ..> UC05A : <<include>>
UC09 ..> UC08 : <<extend>>\n[statut ≤ PAYEE]

A --> UCBA
A --> UC10
A --> UC11
A --> UC12
A --> UC13
A --> UC14
A --> UC16
S --> UC15
@enduml
