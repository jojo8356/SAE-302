@startuml etats_commande
title Machine à états d'une commande — RB-11 (Triggers::TRANSITIONS)

skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName "DejaVu Sans"
skinparam ArrowColor #0F294A
skinparam StateBackgroundColor #FFFFFF
skinparam StateBorderColor #1E3A5F
skinparam NoteBackgroundColor #F8FAFC
skinparam NoteBorderColor #1E3A5F

[*] --> BROUILLON : creation [sp_create_order]

BROUILLON : do / panier convertible, frais_port recalculé
BROUILLON --> EN_PREPARATION : valider [paiement_simule = 0] / trg_history_statut
BROUILLON --> PAYEE : valider [paiement_simule = 1] / trg_history_statut
BROUILLON --> ANNULEE : annuler [client ou abandon] / restitution stock

EN_PREPARATION : do / prix et port figés (RB-06, RB-20)
EN_PREPARATION --> PAYEE : confirmerPaiement [admin] / trg_history_statut
EN_PREPARATION --> EXPEDIEE : expedier [admin] / trg_history_statut
EN_PREPARATION --> ANNULEE : annuler [client ou admin] / sp_cancel_order + restitution stock

PAYEE : do / règlement simulé enregistré
PAYEE --> EXPEDIEE : expedier [admin] / trg_history_statut
PAYEE --> ANNULEE : annuler [client ou admin] / sp_cancel_order + restitution stock

EXPEDIEE : do / colis remis au transporteur
EXPEDIEE --> LIVREE : livrer [admin] / trg_history_statut
EXPEDIEE --> ANNULEE : annuler [admin, motif] / sp_cancel_order_admin + restitution stock

LIVREE : do / état final immuable
ANNULEE : do / frais_port = 0, montant_avant_annulation conservé

LIVREE --> [*]
ANNULEE --> [*]

note bottom of ANNULEE
  Toute transition hors matrice est rejetée par
  trg_commande_transition_statut (SQLSTATE 45000)
  et Triggers::TRANSITIONS (RB11_TRANSITION_STATUT_INTERDITE).
end note
@enduml
